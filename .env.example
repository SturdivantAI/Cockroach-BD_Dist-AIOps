# AWS RDS PostgreSQL
AWS_REGION=us-east-1
DB_BACKEND=rds_postgresql
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=sre_agent
RDS_SECRET_ARN=
RDS_SSLROOTCERT=certs/aws-rds-global.pem
DB_CONNECT_TIMEOUT=10

# Nebius Token Factory
INFERENCE_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
INFERENCE_TIMEOUT_SECONDS=120

# Bedrock embeddings; text model is optional for legacy comparisons
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Memory evidence policy
MEMORY_VALIDATION_ENABLED=true
MEMORY_MAX_AGE_DAYS=30
MEMORY_ALLOW_SIMULATION=false
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.7

# Local UI. Hosted deployments must set DEPLOYMENT_MODE=hosted.
DEPLOYMENT_MODE=local
DEMO_ACCESS_CODE=
LOG_LEVEL=INFO
