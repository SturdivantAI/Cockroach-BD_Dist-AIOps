# Inject values at runtime; do not commit a completed deployment environment file.
DEPLOYMENT_MODE=hosted
# Blank disables hosted live proposals. Generate a random value for judge access.
DEMO_ACCESS_CODE=
AWS_REGION=us-east-1
DB_BACKEND=rds_postgresql
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=sre_agent
RDS_SECRET_ARN=
RDS_SSLROOTCERT=/app/certs/aws-rds-global.pem
INFERENCE_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MEMORY_VALIDATION_ENABLED=true
MEMORY_ALLOW_SIMULATION=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
